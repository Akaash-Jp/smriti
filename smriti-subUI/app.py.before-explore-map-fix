def utc_now():
    return datetime.now(timezone.utc).isoformat()


def db():
    connection = sqlite3.connect(DATABASE_PATH)
    connection.row_factory = sqlite3.Row
    return connection


def init_database():
    connection = db()
    connection.executescript("""
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            email TEXT UNIQUE NOT NULL,
            password_hash TEXT NOT NULL,
            role TEXT NOT NULL DEFAULT 'contributor',
            created_at TEXT NOT NULL
        );
        CREATE TABLE IF NOT EXISTS topics (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            slug TEXT UNIQUE NOT NULL,
            name TEXT NOT NULL,
            description TEXT NOT NULL DEFAULT ''
        );
        CREATE TABLE IF NOT EXISTS contributions (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            owner_id INTEGER NOT NULL,
            topic_id INTEGER NOT NULL,
            title TEXT NOT NULL,
            guide_json TEXT NOT NULL,
            transcript TEXT NOT NULL,
            attribution TEXT NOT NULL DEFAULT '',
            consent INTEGER NOT NULL DEFAULT 0,
            status TEXT NOT NULL DEFAULT 'draft',
            admin_feedback TEXT NOT NULL DEFAULT '',
            created_at TEXT NOT NULL,
            updated_at TEXT NOT NULL,
            submitted_at TEXT,
            published_at TEXT,
            FOREIGN KEY(owner_id) REFERENCES users(id),
            FOREIGN KEY(topic_id) REFERENCES topics(id)
        );
        CREATE TABLE IF NOT EXISTS review_history (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            contribution_id INTEGER NOT NULL,
            reviewer_id INTEGER NOT NULL,
            action TEXT NOT NULL,
            feedback TEXT NOT NULL DEFAULT '',
            created_at TEXT NOT NULL
        );
    """)
    for slug, name in TOPICS:
        connection.execute("INSERT OR IGNORE INTO topics(slug, name) VALUES (?, ?)", (slug, name))
    connection.commit()
    connection.close()


init_database()


def current_user():
    # Flask signs this session cookie, so visitors cannot pretend to be another user.
    user_id = session.get("user_id")
    if not isinstance(user_id, int):
        return None
    connection = db()
    user = connection.execute("SELECT id, email, role FROM users WHERE id = ?", (user_id,)).fetchone()
    connection.close()
    return dict(user) if user else None


def login_required(route):
    @wraps(route)
    def wrapped(*args, **kwargs):
        if not current_user():
            return jsonify({"error": "Please sign in first"}), 401
        return route(*args, **kwargs)
    return wrapped


def admin_required(route):
    @wraps(route)
    def wrapped(*args, **kwargs):
        user = current_user()
        if not user or user["role"] != "admin":
            return jsonify({"error": "Administrator access required"}), 403
        return route(*args, **kwargs)
    return wrapped

