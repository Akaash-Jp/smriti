        menuButton.setAttribute("aria-expanded", String(menuIsOpen));
        document.body.classList.toggle("menu-open", menuIsOpen);
    });
}

function monumentMatchesFilters(monument, stateItem) {
    if (activeCategoryFilter !== "all") {
        if (activeCategoryFilter === "UNESCO") {
            if (!monument.recognition.toLowerCase().includes("unesco")) return false;
        } else if (monument.category !== activeCategoryFilter) {
            return false;
        }
    }

    if (!searchQuery) return true;

    const haystack = [
        stateItem.name,
        stateItem.capital,
        monument.name,
        monument.city,
        monument.category,
        monument.materials,
        monument.tradition
    ].join(" ").toLowerCase();

    return haystack.includes(searchQuery);
}

// --------------------------------------------------
// 4. State Hover & Direct Map Click Highlighting
//    Note: We never detach/re-append state paths during
//    mouseenter so clicks always register reliably!
// --------------------------------------------------
function updateStateHoverPill(stateItem) {
    if (!stateItem || !hoverStateName || !hoverStateMeta) return;
    hoverStateName.textContent = stateItem.name;
    hoverStateMeta.textContent = `${stateItem.type} • Capital: ${stateItem.capital} • ${stateItem.monuments.length} Monuments`;
}

function setupStateInteractions() {
    const statePaths = statesLayer.querySelectorAll(".state-path");

    statePaths.forEach((pathEl) => {
        const stateId = pathEl.dataset.stateId;
        const stateItem = stateById.get(stateId);

        pathEl.addEventListener("mouseenter", () => {
            updateStateHoverPill(stateItem);
        });

        pathEl.addEventListener("focus", () => {
            updateStateHoverPill(stateItem);
        });

        pathEl.addEventListener("mouseleave", () => {
            updateStateHoverPill(stateById.get(selectedStateId));
        });

        pathEl.addEventListener("click", () => {
            selectState(stateId, true);
        });

        pathEl.addEventListener("keydown", (event) => {
            if (event.key === "Enter" || event.key === " ") {
                event.preventDefault();
                selectState(stateId, true);
            }
        });
    });
}

// --------------------------------------------------
// 5. Highlight the Clicked State on the Map and Pop Up
//    its Miniature Monument Icons
// --------------------------------------------------
function selectState(stateId, announceChange = false) {
    const stateItem = stateById.get(stateId);
    if (!stateItem) return;

    selectedStateId = stateId;
    showAllIndiaPins = false;
    if (showAllPinsBtn) {
        showAllPinsBtn.classList.remove("active");
        showAllPinsBtn.textContent = "Show All 80 Icons";
    }

    // Highlight the clicked state and softly dim unselected states so the selection stands out clearly.
    statesLayer.querySelectorAll(".state-path").forEach((pathEl) => {
        const isCurrent = pathEl.dataset.stateId === stateId;
        pathEl.classList.toggle("selected", isCurrent);
        pathEl.classList.toggle("dimmed", !isCurrent);
    });

    // Move the selected state path to the top of statesLayer once on click so its golden border glows cleanly.
    const selectedEl = document.getElementById(`state-${stateId}`);
    if (selectedEl) statesLayer.appendChild(selectedEl);

    document.querySelectorAll(".state-abbr-label").forEach((labelEl) => {
        labelEl.classList.toggle("active-label", labelEl.id === `label-${stateId}`);
    });

    updateStateHoverPill(stateItem);

    const matchingMonuments = stateItem.monuments.filter((m) => monumentMatchesFilters(m, stateItem));
    const listToUse = matchingMonuments.length > 0 ? matchingMonuments : stateItem.monuments;
    if (listToUse.length > 0) {
        selectedMonumentId = listToUse[0].id;
    }

    applyMapViewBox();
    renderMonumentPins();
    renderStateOverviewCard(stateItem);

    const activeMonument = listToUse[0] || stateItem.monuments[0];
    if (activeMonument) {
        renderMonumentDetailCard(activeMonument, stateItem);
    }

    if (announceChange && mapStatusBadge) {
        mapStatusBadge.innerHTML = `<span aria-hidden="true">✦</span> Highlighted <strong>${stateItem.name}</strong> (${listToUse.length} monuments) • Click any miniature icon for details`;
    }
}

function applyMapViewBox() {
    if (!indiaMapSvg) return;
    if (!isZoomedToState) {
        indiaMapSvg.setAttribute("viewBox", "42 26 716 820");
        return;
    }

    const stateItem = stateById.get(selectedStateId);
    if (!stateItem || !stateItem.bbox) {
        indiaMapSvg.setAttribute("viewBox", "42 26 716 820");
        return;
    }

    const [bx, by, bw, bh] = stateItem.bbox;
    const pad = 75;
    const targetW = Math.max(180, bw + pad * 2);
    const targetH = Math.max(200, bh + pad * 2);
    const cx = bx + bw / 2;
    const cy = by + bh / 2;
    const vx = Math.max(0, Math.min(800 - targetW, cx - targetW / 2));
    const vy = Math.max(0, Math.min(900 - targetH, cy - targetH / 2));

    indiaMapSvg.setAttribute("viewBox", `${Math.round(vx)} ${Math.round(vy)} ${Math.round(targetW)} ${Math.round(targetH)}`);
}

// --------------------------------------------------
// 6. Render Zero-Flicker Miniature Monument Icons on the Map
//    Why this never flickers:
//    - An invisible <circle class="monument-hit-area" r="15">
//      stays fixed in size and position to receive pointer events.
//    - The visible miniature inside <g class="monument-visual">
//      has pointer-events: none and scales smoothly without
//      changing the hit box or detaching DOM nodes!
// --------------------------------------------------
function renderMonumentPins() {
    if (!monumentsLayer) return;
    monumentsLayer.innerHTML = "";
    hideMonumentHoverCard(true);

    const pinsToRender = [];
    const statesToScan = (showAllIndiaPins || searchQuery || activeCategoryFilter !== "all")
        ? INDIA_STATES_DATA
        : [stateById.get(selectedStateId)].filter(Boolean);

    statesToScan.forEach((stateItem) => {
        stateItem.monuments.forEach((monument) => {
            if (monumentMatchesFilters(monument, stateItem)) {
                pinsToRender.push({ monument, stateItem });
            }
        });
    });

    if (pinsToRender.length === 0 && !showAllIndiaPins && !searchQuery) {
        const currentState = stateById.get(selectedStateId);
        if (currentState) {
            currentState.monuments.forEach((monument) => {
                pinsToRender.push({ monument, stateItem: currentState });
            });
        }
    }

    if (activePinsStat) {
        activePinsStat.textContent = String(pinsToRender.length);
    }

    const svgNs = "http://www.w3.org/2000/svg";

    pinsToRender.forEach((entry, index) => {
        const { monument, stateItem } = entry;
        const group = document.createElementNS(svgNs, "g");
        group.setAttribute("class", `monument-marker ${monument.id === selectedMonumentId ? "active-pin" : ""}`);
        group.setAttribute("data-monument-id", monument.id);
        group.setAttribute("tabindex", "0");
        group.setAttribute("role", "button");
        group.setAttribute("aria-label", `${monument.name}, ${monument.city}, ${stateItem.name}`);

        // 1. Stationary hit-box circle (never scales, so mouseenter/mouseleave never oscillates)
        const hitArea = document.createElementNS(svgNs, "circle");
        hitArea.setAttribute("class", "monument-hit-area");
        hitArea.setAttribute("cx", String(monument.x));
        hitArea.setAttribute("cy", String(monument.y));
        hitArea.setAttribute("r", "21");

        // 2. Visual container for the miniature monument illustration
        const visualGroup = document.createElementNS(svgNs, "g");
        visualGroup.setAttribute("class", "monument-visual");
        visualGroup.style.animationDelay = `${Math.min(index * 45, 320)}ms`;

        const halo = document.createElementNS(svgNs, "circle");
        halo.setAttribute("class", "miniature-halo");
        halo.setAttribute("cx", String(monument.x));
        halo.setAttribute("cy", String(monument.y));
        halo.setAttribute("r", "20");

        const pedestal = document.createElementNS(svgNs, "circle");
        pedestal.setAttribute("class", "miniature-pedestal");
        pedestal.setAttribute("cx", String(monument.x));
        pedestal.setAttribute("cy", String(monument.y));
        pedestal.setAttribute("r", "16");

        const artGroup = document.createElementNS(svgNs, "g");
        artGroup.setAttribute("class", "miniature-art");
        artGroup.setAttribute("transform", `translate(${monument.x}, ${monument.y}) scale(1.38)`);
        artGroup.innerHTML = createMiniatureMonumentSvg(monument);

        visualGroup.appendChild(halo);
        visualGroup.appendChild(pedestal);
        visualGroup.appendChild(artGroup);

        if (pinsToRender.length <= 12) {
            const caption = document.createElementNS(svgNs, "text");
            caption.setAttribute("class", "miniature-name-tag");
            caption.setAttribute("x", String(monument.x));
            caption.setAttribute("y", String(monument.y - 21));
            caption.textContent = monument.name.length > 22
                ? monument.name.slice(0, 20) + "…"
                : monument.name;
            visualGroup.appendChild(caption);
        }

        group.appendChild(visualGroup);
        group.appendChild(hitArea);

        // ONLY display the details popup card when the user CLICKS on the miniature monument icon (never on hover)
        group.addEventListener("click", (event) => {
            event.stopPropagation();
            selectedStateId = stateItem.id;
            showMonumentHoverCard(monument, stateItem);
            highlightActiveMonument(monument, stateItem);
            renderStateOverviewCard(stateItem);
        });

        group.addEventListener("keydown", (event) => {
            if (event.key === "Enter" || event.key === " ") {
                event.preventDefault();
                window.clearTimeout(hoverHideTimer);
                selectedStateId = stateItem.id;
                showMonumentHoverCard(monument, stateItem);
                highlightActiveMonument(monument, stateItem);
                renderStateOverviewCard(stateItem);
            }
        });

        monumentsLayer.appendChild(group);
    });
}

// --------------------------------------------------
// 7. Interactive Popup Card & "Show more info" Button
//    Keeping the popup open when the mouse enters it
//    lets visitors click "Show more info ↓" smoothly.
// --------------------------------------------------
function showMonumentHoverCard(monument, stateItem) {
    if (!monumentHoverCard || !mapSvgContainer) return;
    window.clearTimeout(hoverHideTimer);

    hoverCardBadge.textContent = `${monument.category} • ${monument.recognition}`;
    hoverCardTitle.textContent = monument.name;
    hoverCardMeta.textContent = `${monument.city}, ${stateItem.name} • ${monument.period}`;
    hoverCardSummary.textContent = monument.summary;
    hoverCardMaterials.textContent = `${monument.materials} — Living craft: ${monument.tradition}`;

    const containerRect = mapSvgContainer.getBoundingClientRect();
    const viewBoxParts = (indiaMapSvg.getAttribute("viewBox") || "42 26 716 820").split(" ").map(Number);
    const [vx, vy, vw, vh] = viewBoxParts;

    const relX = (monument.x - vx) / vw;
    const relY = (monument.y - vy) / vh;

    const pixelX = relX * containerRect.width;
    const pixelY = relY * containerRect.height;

    const cardWidth = Math.min(335, containerRect.width - 28);
    let leftPos = pixelX + 20;
    if (leftPos + cardWidth > containerRect.width - 12) {
        leftPos = Math.max(12, pixelX - cardWidth - 20);
    }

    let topPos = pixelY - 45;
    if (topPos < 12) topPos = 12;
    if (topPos > containerRect.height - 255) {
        topPos = Math.max(12, containerRect.height - 255);
    }

    monumentHoverCard.style.left = `${Math.round(leftPos)}px`;
    monumentHoverCard.style.top = `${Math.round(topPos)}px`;
    monumentHoverCard.classList.add("visible");
    monumentHoverCard.setAttribute("aria-hidden", "false");
}

function scheduleHideMonumentHoverCard() {
    window.clearTimeout(hoverHideTimer);
    hoverHideTimer = window.setTimeout(() => {
        hideMonumentHoverCard(false);
    }, 260);
}

function hideMonumentHoverCard(immediate = false) {
    if (!monumentHoverCard) return;
    if (immediate) {
        window.clearTimeout(hoverHideTimer);
    }
    monumentHoverCard.classList.remove("visible");
    monumentHoverCard.setAttribute("aria-hidden", "true");
}

if (indiaMapSvg) {
    indiaMapSvg.addEventListener("click", () => {
        hideMonumentHoverCard(true);
    });
}

if (closeHoverCardBtn) {
