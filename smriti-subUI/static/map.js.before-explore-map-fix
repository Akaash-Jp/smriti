}

if (showAllPinsBtn) {
    showAllPinsBtn.addEventListener("click", () => {
        showAllIndiaPins = !showAllIndiaPins;
        showAllPinsBtn.classList.toggle("active", showAllIndiaPins);
        showAllPinsBtn.textContent = showAllIndiaPins ? "Show Selected State Only" : "Show All 80 Icons";
        renderMonumentPins();
        if (mapStatusBadge) {
            mapStatusBadge.innerHTML = showAllIndiaPins
                ? `<span aria-hidden="true">✦</span> Showing all <strong>80 monument miniatures</strong> across India • Click any miniature icon for details`
                : `<span aria-hidden="true">✦</span> Highlighted <strong>${stateById.get(selectedStateId)?.name}</strong>`;
        }
    });
}

if (resetMapBtn) {
    resetMapBtn.addEventListener("click", () => {
        isZoomedToState = false;
        showAllIndiaPins = false;
        activeCategoryFilter = "all";
        searchQuery = "";
        if (mapSearchInput) mapSearchInput.value = "";
        if (toggleZoomBtn) {
            toggleZoomBtn.classList.remove("active");
            toggleZoomBtn.textContent = "Zoom to State";
        }
        if (showAllPinsBtn) {
            showAllPinsBtn.classList.remove("active");
            showAllPinsBtn.textContent = "Show All 80 Icons";
        }
        categoryFilterGroup?.querySelectorAll(".filter-chip").forEach((c) => {
            c.classList.toggle("active", c.dataset.filter === "all");
        });
        selectState("IN-TN", true);
    });
}

const totalMonumentsCount = INDIA_STATES_DATA.reduce((sum, st) => sum + st.monuments.length, 0);
if (totalMonumentsStat) totalMonumentsStat.textContent = String(totalMonumentsCount);

const currentYearEl = document.getElementById("currentYear");
if (currentYearEl) currentYearEl.textContent = String(new Date().getFullYear());

setupStateInteractions();
selectState("IN-TN", false);
