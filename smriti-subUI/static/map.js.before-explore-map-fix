// --------------------------------------------------
// 8. Populate the Bottom-Half "More Info" Dossier
// --------------------------------------------------
function highlightActiveMonument(monument, stateItem) {
    selectedMonumentId = monument.id;

    monumentsLayer.querySelectorAll(".monument-marker").forEach((pinEl) => {
        pinEl.classList.toggle("active-pin", pinEl.dataset.monumentId === monument.id);
    });

    stateMonumentList.querySelectorAll(".state-monument-btn").forEach((btnEl) => {
        btnEl.classList.toggle("active", btnEl.dataset.monumentId === monument.id);
    });

    renderMonumentDetailCard(monument, stateItem);
}

function renderStateOverviewCard(stateItem) {
    if (!stateItem) return;
    selectedStateRegion.textContent = `${stateItem.region} • Capital: ${stateItem.capital}`;
    selectedStateTitle.textContent = stateItem.name;
    selectedStateType.textContent = stateItem.type;
    selectedStateTagline.textContent = stateItem.tagline;

    stateMonumentList.innerHTML = "";
    stateItem.monuments.forEach((monument) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = `state-monument-btn ${monument.id === selectedMonumentId ? "active" : ""}`;
        btn.dataset.monumentId = monument.id;
        btn.innerHTML = `
            <div>
                <strong>${monument.name}</strong>
                <span>${monument.city} • ${monument.period}</span>
            </div>
            <span class="monument-pin-badge">${monument.category}</span>
        `;

        btn.addEventListener("click", () => {
            highlightActiveMonument(monument, stateItem);
        });

        stateMonumentList.appendChild(btn);
    });
}

function renderMonumentDetailCard(monument, stateItem) {
    if (!monument || !stateItem) return;

    detailMonumentImage.src = (typeof ASSET_IMAGES !== "undefined" && ASSET_IMAGES[monument.image])
        ? ASSET_IMAGES[monument.image]
        : monument.image;
    detailMonumentImage.alt = `${monument.name} in ${monument.city}, ${stateItem.name}`;
    detailRecognitionTag.textContent = monument.recognition;
    detailCoordsTag.textContent = `${monument.lat.toFixed(2)}° N, ${monument.lng.toFixed(2)}° E`;
    detailCategoryLocation.textContent = `${monument.category} • ${monument.city}, ${stateItem.name}`;
    detailMonumentTitle.textContent = monument.name;
    detailPeriodLine.textContent = monument.period;
    detailSummaryText.textContent = monument.summary;
    detailMaterialsText.textContent = monument.materials;
    detailTraditionText.textContent = `${monument.tradition} (${monument.community})`;
    detailStoryText.textContent = monument.story;

    const chainSteps = [
        `${monument.city}, ${stateItem.name}`,
        monument.name,
        monument.materials.split(",")[0],
        monument.tradition.split(",")[0],
        monument.community.split(",")[0]
    ];

    knowledgeNodes.innerHTML = chainSteps
        .map((step, idx) => {
            const arrow = idx < chainSteps.length - 1 ? '<span class="knowledge-arrow" aria-hidden="true">→</span>' : '';
            return `<span class="knowledge-node">${step}</span>${arrow}`;
        })
        .join("");

    detailSourceLink.href = monument.sourceUrl;
    detailSourceLink.textContent = `Source: ${monument.sourceLabel} ↗`;

    if ("speechSynthesis" in window && window.speechSynthesis.speaking) {
        window.speechSynthesis.cancel();
        audioGuideBtnText.textContent = "Listen to audio guide";
    }
}

// --------------------------------------------------
// 9. Spoken Audio Guide in the More Info Section
// --------------------------------------------------
if (audioGuideBtn) {
    audioGuideBtn.addEventListener("click", () => {
        const stateItem = stateById.get(selectedStateId);
        const monument = stateItem?.monuments.find((m) => m.id === selectedMonumentId) || stateItem?.monuments[0];
        if (!monument || !stateItem) return;

        if (!("speechSynthesis" in window)) {
            showToast("Audio narration is not supported in this browser.");
            return;
        }

        if (window.speechSynthesis.speaking) {
            window.speechSynthesis.cancel();
            audioGuideBtnText.textContent = "Listen to audio guide";
            return;
        }

        const narrationText = `${monument.name}, in ${monument.city}, ${stateItem.name}. ${monument.period}. ${monument.summary} Materials used: ${monument.materials}. Living tradition: ${monument.tradition}. ${monument.story}`;
        const utterance = new SpeechSynthesisUtterance(narrationText);
        utterance.rate = 0.96;
        utterance.onend = () => {
            audioGuideBtnText.textContent = "Listen to audio guide";
        };
        utterance.onerror = () => {
            audioGuideBtnText.textContent = "Listen to audio guide";
        };

        audioGuideBtnText.textContent = "Stop audio guide";
        window.speechSynthesis.speak(utterance);
    });
}

